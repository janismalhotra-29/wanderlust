<%layout("/layouts/boilerplate")%>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>Edit your listing Listing</h3>
            <form method="POST" action="/listings/<%=listing._id%>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                <div>
                    <lable for="title" class="form-label">Title</lable>
                    <input type="text" name="listing[title]" value="<%=listing.title%>" class="form-control" required> 
                     <div class="invalid-feedback">
                       
                    Please enter a title
                    </div><br> <br>
                </div>
                <div>
                    <lable for="title" class="form-label">Title</lable>
                    <textarea name="listing[description]"  class="form-control" required><%=listing.description%></textarea>
                     <div class="invalid-feedback">
                       
                    Please enter a short description
                    </div> <br> <br>
                </div>

                <div class="mb-3">
                    Original Listing Image
                    <br>
                   <img src="<%= originalImageUrl%>" />

                      <br> <br>
                </div>



                <div>
                    <lable for="image" class="form-label">Upload New image Link </lable>
                    <input type="file" name="listing[image]"  class="form-control" >

                      <br> <br>
                </div>
                <div class="row">
                    <div class="col-md-4">
                        <lable for="price" class="form-label">Price</lable>
                        <input  name="listing[price]" value="<%=listing.price%>" class="form-control" required> 
                         <div class="invalid-feedback">
                       
                    Please enter valid price
                    </div><br> <br>
                    </div>
                    <div class="col-md-8">
                        <lable for="country" class="form-label">Country</lable>
                        <input type="text" name="listing[country]" required ,value="<%=listing.country%>" class="form-control"> 
                         <div class="invalid-feedback">
                       
                    Please enter a valid country- name
                    </div><br> <br>
                    </div>
                </div>
                <div>
                    <lable for="location" class="form-label">Location</lable>
                    <input type="text" name="listing[location]" required value="<%=listing.location%>" class="form-control"> 
                     <div class="invalid-feedback">
                       
                    Please enter a valid location
                    </div><br> <br>
                </div>
                <button class="btn btn-dark edit-btn mt-3">Add</button>
            </form>
        </div>
    </div>
