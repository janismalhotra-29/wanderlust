<%layout("/layouts/boilerplate")%>
<body>
    <div class="row mt-3">
        <div class="col-8 offset-2">
            <h3>Create a New Listing</h3>
            <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                <div >
                    <lable for="title" class="form-label">Title</lable>
                    <input type="text" name="listing[title]" placeholder="add a catch title" class="form-control" required> 
                    <div class="valid-feedback">
                        Title looks good

                    </div>
                    <br> <br>
                </div>
                <div >
                    <lable for="description" class="form-label">Description</lable>
                    <textarea name="listing[description]" class="form-control" required></textarea>
                     <div class="invalid-feedback">
                       
                    Please enter a short description
                    </div> <br> <br>
                </div>
               

                 <div >
                    <lable for="image" class="form-label">Upload Listing Image</lable>
                    <input type="file" name="listing[image]" class="form-control" > 
                    required
                    <br> <br>
                </div>
                <div class="row">
                    <div class="mb-3 col-4 md-4">
                        <lable for="price" class="form-label">Price</lable>
                        <input class="form-control" required type="number" name="listing[price]" placeholder="1200"> 
                         <div class="invalid-feedback">
                        Price looks Valid

                    </div><br> <br>
                    </div>
                    <div class=" col-8 md-8">
                        <lable for="country" class="form-label">Country</lable>
                        <input type="text" name="listing[country]" placeholder="India" class="form-control" required>
                         <div class="invalid-feedback">
                       Please enter valid country 

                    </div> <br> <br>
                    </div>
                </div>
                <div >
                    <lable for="location" class="form-label">Location</lable>
                    <input type="text" name="listing[location]" placeholder="Jaipur,Rajasthan" class="form-control "required>
                     <div class="invalid-feedback">
                       Please enter a valid location 

                    </div> <br> <br>
                </div>
                <button class="btn btn-dark add-btn mt-3">Add</button>
            </form>
        </div>
    </div>
</body>