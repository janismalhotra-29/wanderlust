<% layout("/layouts/boilerplate") %>

<style>
    body {
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    .signup-page {
        flex: 1;
        min-height: calc(100vh - 180px);
    }

    footer {
        width: 100%;
    }
</style>

<div class="signup-page">
    <div class="row mt-3">
        <h1 class="col-6 offset-3">Signup on Wanderlust</h1>
        <div class="col-6 offset-3">

            <form action="/signup" method="POST" class="needs-validation" novalidate>

                <div class="mb-3">
                    <label for="username" class="form-label">
                        Username
                    </label>

                    <input
                        type="text"
                        name="username"
                        id="username"
                        class="form-control"
                        required
                    >

                    <div class="valid-feedback">
                        Looks good!
                    </div>
                    
                    <div class="mb-3">
                    <label for="email" class="form-label">
                     email
                    </label>

                    <input
                        type="text"
                        name="email"
                        id="email"
                        class="form-control"
                        required
                    >

                   
                       <div class="mb-3">
                    <label for="password" class="form-label">
                        Password
                    </label>

                    <input
                        type="password"
                        name="password"
                        id="password"
                        class="form-control"
                        required
                    >

                    </div>
                <button class="btn btn-success">
                    Signup
                </button>

                </div>

            </form>

        </div>
    </div>
</div>